{
  "name": "astro-blog-2026",
  "description": "Hello Astro is a full featured Astro corporate/marketing/blog starter theme written in Typescript and TailwindCSS. It supports Markdown and MDX based pages and blog posts.",
  "version": "5.2.0",
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf node_modules .astro dist",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "pnpm run lint:prettier ; pnpm run lint:eslint",
    "lint:prettier": "prettier --write  \"src/**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "lint:eslint": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,md,mdx,astro}\"",
    "refresh": "pnpm dlx @astrojs/upgrade; pnpm up -L",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/alpinejs": "^3.17.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": ">=4.8.4 <6.1.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/markdoc": "^2.1.1",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "astro-leaflet": "^1.12.0",
    "astro-masonry": "^1.2.2",
    "astro-mermaid": "^2.1.0",
    "astro-plantuml": "^1.0.1",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "astro-swiper": "^2.11.0",
    "exifr": "^7.1.3",
    "hero-patterns": "^2.1.0",
    "lunr": "^2.3.9",
    "mdast-util-to-string": "^4.0.0",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-emoji": "^5.0.2",
    "remark-math": "^6.0.0",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
